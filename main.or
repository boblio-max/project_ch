# ============================================================
# COPYHATCH v0.1.0 -- FULL opencode mech suit, written in Origin
# An opencode-style TUI in a mech HUD. Run: origin main.or
#
# MODULES (single-file suit: Origin 1.7.x inlines only stdlib
# imports, so plates live as sections, split when v1.8 lands):
#   [CORE]    suit state + reactor math
#   [TUI]     hud rendering + opencode-style REPL
#   [TOOLS]   FULL tool set: bash / read / write / web / pilot
#   [SESSION] mission log persistence
# ============================================================

# ---------------- [CORE] suit state ----------------

def bar(pct) {
    let filled:int = pct // 10
    let s:str = "["
    for k in range(0, 10) {
        if k < filled {
            s = s + "#"
        } else {
            s = s + "-"
        }
    }
    s = s + "]"
    return s
}

def drain(reactor, cost) {
    let r:int = reactor - cost
    if r < 0 {
        r = 0
    }
    return r
}

def charge(reactor, gain) {
    let r:int = reactor + gain
    if r > 100 {
        r = 100
    }
    return r
}

def wear(armor, n) {
    let a:int = armor - n
    if a < 0 {
        a = 0
    }
    return a
}

def suit_reply(missions) {
    let r:int = missions % 3
    if r == 0 {
        return "Copy that. Plating your plan in armor."
    }
    if r == 1 {
        return "Reactor humming. Objective locked in the visor."
    }
    return "Gauntlets ready. Give me the next objective."
}

# ---------------- [TUI] hud + screens ----------------

def banner() {
    print "+===============================================+"
    print "|  C O P Y H A T C H   v0.1.0                   |"
    print "|  FULL opencode mech suit -- Origin-built TUI   |"
    print "|      [###]         [###]                      |"
    print "|     Reactor core: ONLINE                      |"
    print "+===============================================+"
}

def hud(reactor, armor, model, missions) {
    print "+-- COPYHATCH HUD ---------------------------------+"
    print "| REACTOR " + bar(reactor) + " " + str(reactor) + "%  ARMOR " + str(armor) + "% |"
    print "| MODEL " + model + "  MISSIONS " + str(missions) + "            |"
    print "+-------------------------------------------------+"
}

def help_screen() {
    print "-- commands (opencode-style, mech-flavored) --"
    print "  /help    this plate"
    print "  /suit    hud status"
    print "  /tools   FULL tool manifest"
    print "  /model   swap pilot model"
    print "  /read    read a file"
    print "  /write   write a file"
    print "  /bash    run a shell command"
    print "  /web     fetch a url (first bytes)"
    print "  /log     show session log"
    print "  /clear   wipe the visor"
    print "  /repair  restore armor (10 reactor)"
    print "  /pilot   suit-link into REAL opencode TUI"
    print "  /exit    eject (quit)"
}

def tools_screen() {
    print "-- FULL tool manifest: every plate live --"
    let plates:list = ["bash", "read", "write", "web", "pilot", "suit", "model", "log"]
    for plate in plates {
        print "  [ON] " + plate
    }
}

# ---------------- [SESSION] mission log ----------------

def logline(tag, msg) {
    py {
        open("session.log", "a", encoding="utf-8").write(tag + ": " + msg + "\n")
    }
}

def show_log() {
    py {
        try:
            print(open("session.log", encoding="utf-8").read())
        except Exception as e:
            print("[suit] no session log yet")
    }
}

# ---------------- [TOOLS] implementations ----------------

def tool_bash() {
    let cmd:str = input "bash> "
    py {
        import subprocess
        try:
            r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=60)
            out = r.stdout + r.stderr
            if not out.strip():
                out = "[exit " + str(r.returncode) + "]"
            print(out)
        except Exception as e:
            print("[suit] bash failed: " + str(e))
    }
    logline("bash", cmd)
}

def tool_read() {
    let path:str = input "path> "
    py {
        try:
            print(open(path, encoding="utf-8").read())
        except Exception as e:
            print("[suit] cannot read " + path)
    }
    logline("read", path)
}

def tool_write() {
    let path:str = input "path> "
    let text:str = input "text> "
    py {
        try:
            open(path, "w", encoding="utf-8").write(text + "\n")
            print("[suit] plated " + path)
        except Exception as e:
            print("[suit] cannot write " + path)
    }
    logline("write", path)
}

def tool_web() {
    let url:str = input "url> "
    py {
        try:
            import urllib.request
            req = urllib.request.Request(url, headers={"User-Agent": "copyhatch/0.1"})
            body = urllib.request.urlopen(req, timeout=15).read().decode("utf-8", "replace")
            print(body[:600])
        except Exception as e:
            print("[suit] fetch failed")
    }
    logline("web", url)
}

def tool_model(model) {
    print "-- pilot models --"
    let models:list = ["muse-spark", "opus-mech", "sonnet-scout"]
    let n:int = 1
    for m in models {
        print "  " + str(n) + " " + m
        n = n + 1
    }
    let pick:str = input "select> "
    if pick == "1" {
        print "[suit] model = muse-spark"
        return "muse-spark"
    }
    if pick == "2" {
        print "[suit] model = opus-mech"
        return "opus-mech"
    }
    if pick == "3" {
        print "[suit] model = sonnet-scout"
        return "sonnet-scout"
    }
    print "[suit] keeping " + model
    return model
}

def tool_pilot() {
    print "[suit] opening suit-link to REAL opencode (quit it to return)..."
    py {
        import subprocess
        subprocess.run("opencode", shell=True)
    }
    logline("pilot", "suit-link session")
}

def clear_visor() {
    py {
        import os
        os.system("cls" if os.name == "nt" else "clear")
    }
}

# ---------------- boot ----------------

banner()
py {
    import shutil
    print("real-opencode: " + ("detected" if shutil.which("opencode") else "missing (npm i -g opencode)"))
}
logline("SUIT", "boot")

let reactor:int = 82
let armor:int = 100
let model:str = "muse-spark"
let missions:int = 0

hud(reactor, armor, model, missions)
print "type /help to see plates, /exit to eject."

# ---------------- [TUI] opencode-style REPL ----------------

let running:bool = true
while running == true {
    let prompt:str = "copyhatch/" + model + "> "
    let msg:str = input prompt
    if msg == "/exit" {
        running = false
    } else {
        if msg == "/help" {
            help_screen()
        } else {
            if msg == "/suit" {
                hud(reactor, armor, model, missions)
            } else {
                if msg == "/tools" {
                    tools_screen()
                } else {
                    if msg == "/model" {
                        model = tool_model(model)
                        logline("model", model)
                    } else {
                        if msg == "/bash" {
                            tool_bash()
                            reactor = drain(reactor, 8)
                            armor = wear(armor, 1)
                            missions = missions + 1
                        } else {
                            if msg == "/read" {
                                tool_read()
                                reactor = drain(reactor, 3)
                                missions = missions + 1
                            } else {
                                if msg == "/write" {
                                    tool_write()
                                    reactor = drain(reactor, 5)
                                    armor = wear(armor, 1)
                                    missions = missions + 1
                                } else {
                                    if msg == "/web" {
                                        tool_web()
                                        reactor = drain(reactor, 6)
                                        missions = missions + 1
                                    } else {
                                        if msg == "/log" {
                                            show_log()
                                        } else {
                                            if msg == "/clear" {
                                                clear_visor()
                                                hud(reactor, armor, model, missions)
                                            } else {
                                                if msg == "/repair" {
                                                    if reactor < 10 {
                                                        print "[suit] reactor too low to repair"
                                                    } else {
                                                        reactor = drain(reactor, 10)
                                                        armor = 100
                                                        print "[suit] armor restored to 100%"
                                                    }
                                                } else {
                                                    if msg == "/pilot" {
                                                        tool_pilot()
                                                        hud(reactor, armor, model, missions)
                                                    } else {
                                                        let reply:str = suit_reply(missions)
                                                        print "suit: " + reply
                                                        logline("you", msg)
                                                        logline("suit", reply)
                                                        reactor = charge(reactor, 2)
                                                        missions = missions + 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if reactor == 0 {
            print "[suit] WARNING: reactor depleted. run /repair-free missions to recharge."
            reactor = charge(reactor, 5)
        }
    }
}

print "+-- ejecting. suit parked. session sealed. --+"
logline("SUIT", "eject")
